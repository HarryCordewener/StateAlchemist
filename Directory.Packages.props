<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- The 11.0 runtime packages target net10.0, net11.0, .NET Standard and .NET Framework, and a buildTransitive
       target in them fails a net8.0 build ("doesn't support net8.0"). So net8.0 keeps the 10.0 line and every
       other target, netstandard2.0 included, takes 11.0. A single-target project sets TargetFramework after these
       props are read, so it gets 11.0; none of those targets net8.0. -->
  <PropertyGroup>
    <_RuntimePackagesOnNet8 Condition="'$(TargetFramework)' != '' AND '$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))' == '.NETCoreApp' AND !$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">true</_RuntimePackagesOnNet8>
    <RuntimePackagesVersion>11.0.0</RuntimePackagesVersion>
    <RuntimePackagesVersion Condition="'$(_RuntimePackagesOnNet8)' == 'true'">10.0.14</RuntimePackagesVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="$(RuntimePackagesVersion)" />
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="$(RuntimePackagesVersion)" />
    <PackageVersion Include="System.IO.Pipelines" Version="$(RuntimePackagesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(RuntimePackagesVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(RuntimePackagesVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="Stateless" Version="5.20.1" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
    <PackageVersion Include="TUnit.Core" Version="1.87.12" />
    <PackageVersion Include="TUnit.Assertions" Version="1.87.12" />
    <PackageVersion Include="PublicApiGenerator" Version="11.5.4" />
    <PackageVersion Include="Verify.TUnit" Version="33.7.1" />
  </ItemGroup>
</Project>
